# Run ./init.sh postiz.example.com to generate .env with unique secrets.
POSTIZ_DOMAIN=postiz.example.com
JWT_SECRET=replace-with-long-random-hex
POSTIZ_DB_PASSWORD=replace-with-random-hex
TEMPORAL_DB_PASSWORD=replace-with-random-hex
DISABLE_REGISTRATION=true
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
API_LIMIT=30
# For production video delivery, set STORAGE_PROVIDER=cloudflare and configure
# an R2 bucket with a public custom domain. See README.
STORAGE_PROVIDER=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto
